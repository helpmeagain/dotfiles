#!/usr/bin/env bash

set -Eeuo pipefail

DATA=$(date '+%Y-%m-%d_%H-%M-%S')

LOGDIR="$HOME/.config/home_backup"
mkdir -p "$LOGDIR"

SALVAR_LOG=true

ORIGENS=(
    "Documentos/Arquivos sensíveis"
    "Documentos/Documentos digitalizados"
    "Imagens/Profile"
    "Imagens/Wallpapers"
    "Imagens/Stickers"
)

DESTINOS_PADRAO=(
    "/mnt/HDD1/HomeBackup"
    "/mnt/HDD2/HomeBackup"
    "/mnt/HDD3/HomeBackup"
    "/mnt/SSD1/HomeBackup"
)

DESTINOS=()

while (( $# > 0 )); do
    case "$1" in
        --no-log)
            SALVAR_LOG=false
            ;;
        *)
            DESTINOS+=("$1")
            ;;
    esac
    shift
done

if (( ${#DESTINOS[@]} == 0 )); then
    DESTINOS=("${DESTINOS_PADRAO[@]}")
fi

echo
echo "========================================="
echo "Verificando integridade dos arquivos sensíveis"
echo "========================================="
echo

SENSITIVE_DIR="$HOME/Documentos/Arquivos sensíveis"

(
    cd "$SENSITIVE_DIR"
    gpg --verify manifest.sha256.sig manifest.sha256
    sha256sum -c manifest.sha256
)

echo
echo "[OK] Verificação PGP + integridade concluída"
echo

echo "========================================="
echo "Backup iniciado em $(date)"
echo "========================================="
echo

cd "$HOME"

for origem in "${ORIGENS[@]}"; do
    if [[ ! -e "$origem" ]]; then
        echo "[ERRO] Origem não encontrada: $HOME/$origem"
        exit 1
    fi
done

SUCESSOS=0
FALHAS=0

for destino in "${DESTINOS[@]}"; do
    echo
    echo "-----------------------------------------"
    echo "Destino: $destino"
    echo "-----------------------------------------"

    mkdir -p "$destino"

    NOME_DESTINO=$(basename "$(dirname "$destino")")
    LOG="$LOGDIR/${NOME_DESTINO}-${DATA}.log"

    if $SALVAR_LOG; then

        {
            echo
            echo "========================================="
            echo "Backup para: $destino"
            echo "Início: $(date)"
            echo "========================================="
        } >> "$LOG"

        RSYNC_OUTPUT=(tee -a "$LOG")

    else

        RSYNC_OUTPUT=(cat)

    fi

    if rsync \
        -aR \
        -c \
        --delete \
        --partial \
        --human-readable \
        --stats \
        --itemize-changes \
        --info=progress2 \
        "${ORIGENS[@]}" \
        "$destino" \
        2>&1 | "${RSYNC_OUTPUT[@]}"
    then
        echo "[OK] Backup concluído: $destino"

        if $SALVAR_LOG; then
            echo "[OK] Backup concluído: $destino" >> "$LOG"
        fi

        ((SUCESSOS+=1))
    else
        echo "[ERRO] Falha no backup: $destino"

        if $SALVAR_LOG; then
            echo "[ERRO] Falha no backup: $destino" >> "$LOG"
        fi

        ((FALHAS+=1))
    fi
done

echo
echo "========================================="
echo "Resumo"
echo "========================================="
echo "Sucessos: $SUCESSOS"
echo "Falhas:   $FALHAS"
echo "Fim:      $(date)"
echo "========================================="

if $SALVAR_LOG; then
    echo
    echo "Logs salvos em:"
    echo "  $LOGDIR"
fi